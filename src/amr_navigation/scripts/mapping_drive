#!/usr/bin/env python3
"""Slow SLAM-pose waypoints with scan interlock, for a fresh world only."""
import argparse
import math
from pathlib import Path
import subprocess
import sys
import time
import yaml
import rclpy
from rclpy.node import Node
from rclpy.parameter import Parameter
from rclpy.qos import qos_profile_sensor_data
from geometry_msgs.msg import TwistStamped
from nav_msgs.msg import Odometry
from sensor_msgs.msg import LaserScan
from tf2_ros import Buffer, TransformListener
from rclpy.time import Time
from ament_index_python.packages import get_package_share_directory

def main():
    parser=argparse.ArgumentParser(description='Controlled mapping route; start mapping.launch.py first')
    parser.add_argument('--save',default='artifacts/maps/mapped_warehouse_v1')
    args=parser.parse_args(); rclpy.init(); node=Node('mapping_drive',parameter_overrides=[Parameter('use_sim_time',value=True)])
    odom=[None,0.]; scan=[None,0.]
    node.create_subscription(Odometry,'/odom',lambda m:odom.__setitem__(slice(None),[m,time.monotonic()]),qos_profile_sensor_data)
    node.create_subscription(LaserScan,'/scan',lambda m:scan.__setitem__(slice(None),[m,time.monotonic()]),qos_profile_sensor_data)
    pub=node.create_publisher(TwistStamped,'/diff_drive_controller/cmd_vel',1)
    buffer=Buffer(); listener=TransformListener(buffer,node)
    def slam_pose():
        tf=buffer.lookup_transform('map','base_footprint',Time())
        age=node.get_clock().now().nanoseconds*1e-9-(tf.header.stamp.sec+tf.header.stamp.nanosec*1e-9)
        if not -.3<=age<1.: raise RuntimeError('SLAM transform stale')
        q=tf.transform.rotation
        yaw=math.atan2(2*(q.w*q.z+q.x*q.y),1-2*(q.y*q.y+q.z*q.z))
        return tf.transform.translation.x,tf.transform.translation.y,yaw
    def command(v=0.,w=0.):
        m=TwistStamped(); m.header.stamp=node.get_clock().now().to_msg(); m.header.frame_id='base_footprint'; m.twist.linear.x=v; m.twist.angular.z=w; pub.publish(m)
    try:
        deadline=time.monotonic()+90
        while time.monotonic()<deadline:
            rclpy.spin_once(node,timeout_sec=.1)
            try: slam_pose(); localized=True
            except Exception: localized=False
            if odom[0] and scan[0] and localized: break
        if not odom[0] or not scan[0] or not localized: raise TimeoutError('mapping sensors or active SLAM transform unavailable')
        # SLAM starts at (0,0); the known spawn supplies only the fixed origin.
        # Use scan-corrected SLAM pose throughout, not accumulated wheel odometry.
        route=[(3,3),(9,3),(17,3),(17,12),(10,12.5),(3,12),(2,7.5)]
        for wx,wy in route:
            end=time.monotonic()+240
            while time.monotonic()<end:
                rclpy.spin_once(node,timeout_sec=.05)
                if time.monotonic()-odom[1]>.5 or time.monotonic()-scan[1]>1: command(); raise RuntimeError('sensor stale')
                x,y,yaw=slam_pose()
                dx,dy=wx-2-x,wy-7.5-y; distance=math.hypot(dx,dy)
                if distance<.12:
                    command(); print(f'Waypoint ({wx},{wy}) reached via SLAM ({x:.3f},{y:.3f})',flush=True); break
                error=math.remainder(math.atan2(dy,dx)-yaw,2*math.pi)
                s=scan[0]; front=[r for i,r in enumerate(s.ranges) if abs(math.remainder(s.angle_min+i*s.angle_increment,2*math.pi))<.35 and math.isfinite(r)]
                around=[r for r in s.ranges if math.isfinite(r)]
                if (front and min(front)<.45) or (around and min(around)<.35):
                    command(); raise RuntimeError(f'mapping route obstructed at SLAM ({x:.3f},{y:.3f}); stopped')
                command(min(.20,.5*distance) if abs(error)<.25 else 0.,max(-.6,min(.6,1.5*error)))
            else: raise TimeoutError('mapping waypoint deadline')
        command(); target=Path(args.save).resolve(); target.parent.mkdir(parents=True,exist_ok=True)
        subprocess.run(['ros2','run','nav2_map_server','map_saver_cli','-f',str(target),'--ros-args','-p','use_sim_time:=true'],check=True,timeout=30)
        map_path=target.with_suffix('.yaml'); data=yaml.safe_load(map_path.read_text()); data['map_id']=target.name
        # Analytic simulation origin alignment; no post-hoc fit to measured trajectory.
        data['origin'][0]+=2.; data['origin'][1]+=7.5
        map_path.write_text(yaml.safe_dump(data),encoding='utf-8')
        source=Path(get_package_share_directory('amr_mission'))/'config/stations.yaml'
        stations=yaml.safe_load(source.read_text()); stations['map_id']=target.name
        target.with_name(target.name+'_stations.yaml').write_text(yaml.safe_dump(stations),encoding='utf-8')
        print(f'Saved {map_path}. Stop mapping and restart system with map/stations overrides; registry rechecks full footprint.')
        return 0
    except Exception as e: print(str(e),file=sys.stderr); return 1
    finally:
        for _ in range(3): command()
        node.destroy_node(); rclpy.try_shutdown()
if __name__=='__main__': sys.exit(main())
