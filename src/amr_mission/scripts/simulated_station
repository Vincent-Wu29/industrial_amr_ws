#!/usr/bin/env python3
"""Independent station actor. Manual is the default; no navigation shortcut."""
import time
import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, DurabilityPolicy
from amr_interfaces.msg import TaskSnapshot
from amr_interfaces.srv import ConfirmOperation

class Station(Node):
    def __init__(self):
        super().__init__('simulated_station')
        self.mode=self.declare_parameter('mode','manual').value
        if self.mode not in ('manual','scripted_success','failure','silent'): raise ValueError('invalid station mode')
        self.delay=float(self.declare_parameter('delay_s',1.).value)
        self.pending=None; self.seen=set(); self.future=None
        self.client=self.create_client(ConfirmOperation,'/mission/confirm_operation')
        self.create_subscription(TaskSnapshot,'/mission/state',self.state,QoSProfile(depth=1,durability=DurabilityPolicy.TRANSIENT_LOCAL))
        self.create_timer(.1,self.tick)
    def state(self,m):
        if self.mode in ('manual','silent'): return
        if m.state not in (m.WAITING_FOR_LOAD,m.WAITING_FOR_UNLOAD):
            self.pending=None; return
        key=(m.run_id,m.task_id,m.interaction_id)
        if key in self.seen: return
        self.seen.add(key); self.pending=(self.get_clock().now().nanoseconds*1e-9+self.delay,m)
    def tick(self):
        if not self.pending or not self.client.service_is_ready(): return
        deadline,m=self.pending
        if self.get_clock().now().nanoseconds*1e-9<deadline: return
        req=ConfirmOperation.Request(run_id=m.run_id,task_id=m.task_id,station_id=m.current_station,
            interaction_id=m.interaction_id,operation=1 if m.state==m.WAITING_FOR_LOAD else 2,
            outcome=1 if self.mode=='scripted_success' else 2)
        self.future=self.client.call_async(req); self.pending=None
        self.future.add_done_callback(lambda f:self.get_logger().info(str(f.result())))

def main():
    rclpy.init(); node=Station()
    try: rclpy.spin(node)
    except KeyboardInterrupt: pass
    finally: node.destroy_node(); rclpy.try_shutdown()
if __name__=='__main__': main()
