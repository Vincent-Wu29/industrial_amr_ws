#!/usr/bin/env python3
"""Moves real collision fixtures through Gazebo's UserCommands service."""
import argparse
import json
import subprocess
import sys
import time
import math
from pathlib import Path
import rclpy
from rclpy.node import Node
from rclpy.parameter import Parameter
from geometry_msgs.msg import PoseStamped, Twist

def main():
    p=argparse.ArgumentParser()
    p.add_argument('--scenario',choices=['crossing','temporary','permanent'],required=True)
    p.add_argument('--seed',type=int,default=42)
    p.add_argument('--output',default='artifacts/obstacles.jsonl')
    p.add_argument('--trigger-x',type=float,default=11.)
    p.add_argument('--trigger-y',type=float,default=10.5)
    p.add_argument('--trigger-radius',type=float,default=1.8)
    args=p.parse_args(rclpy.utilities.remove_ros_args()[1:]); rclpy.init()
    n=Node('scenario_controller',parameter_overrides=[Parameter('use_sim_time',value=True)])
    current=[None]; n.create_subscription(PoseStamped,'/ground_truth/pose',lambda m:current.__setitem__(0,m),10)
    pub=n.create_publisher(PoseStamped,'/scenario/box_pose',10)
    velocity_pub=n.create_publisher(Twist,'/scenario/cmd_vel',1)
    output=Path(args.output); output.parent.mkdir(parents=True,exist_ok=True)
    log=output.open('a',encoding='utf-8',buffering=1)
    def record(name,x,y):
        m=PoseStamped(); m.header.stamp=n.get_clock().now().to_msg(); m.header.frame_id=name
        m.pose.position.x=float(x); m.pose.position.y=float(y); m.pose.position.z=.5; m.pose.orientation.w=1.
        pub.publish(m)
        log.write(json.dumps({'sim_s':n.get_clock().now().nanoseconds*1e-9,'fixture':name,'x':x,'y':y,'seed':args.seed})+'\n')
        rclpy.spin_once(n,timeout_sec=.01)
    def move(name,x,y):
        request=f'name: "{name}", position: {{x: {x}, y: {y}, z: 0.5}}, orientation: {{w: 1}}'
        completed=subprocess.run(['gz','service','-s','/world/warehouse/set_pose','--reqtype','gz.msgs.Pose','--reptype','gz.msgs.Boolean','--timeout','3000','--req',request],capture_output=True,text=True,timeout=5)
        if completed.returncode or 'true' not in completed.stdout: raise RuntimeError('Gazebo set_pose failed: '+completed.stdout+completed.stderr)
        record(name,x,y)
    def velocity(x=0.):
        message=Twist(); message.linear.x=x; velocity_pub.publish(message)
    try:
        if args.scenario=='permanent':
            for name,x,y in [('enclosure_west',16.,12.),('enclosure_east',18.,12.),('enclosure_south',17.,11.),('enclosure_north',17.,13.)]: move(name,x,y)
        else:
            deadline=time.monotonic()+300
            def triggered():
                if current[0] is None: return False
                p=current[0].pose.position
                return p.y<=args.trigger_y and math.hypot(p.x-args.trigger_x,p.y-args.trigger_y)<=args.trigger_radius
            while not triggered() and time.monotonic()<deadline: rclpy.spin_once(n,timeout_sec=.1)
            if not triggered(): raise TimeoutError('obstacle interaction region not reached')
            start_x=args.trigger_x if args.scenario=='temporary' else args.trigger_x-1.
            move('scenario_box',start_x,args.trigger_y)
            start=n.get_clock().now().nanoseconds*1e-9
            duration=5. if args.scenario=='temporary' else 6.
            while n.get_clock().now().nanoseconds*1e-9-start<duration:
                elapsed=n.get_clock().now().nanoseconds*1e-9-start
                velocity(0. if args.scenario=='temporary' else .25)
                record('scenario_box',start_x+(0 if args.scenario=='temporary' else .25*elapsed),args.trigger_y)
                next_sim=n.get_clock().now().nanoseconds*1e-9+.05
                while n.get_clock().now().nanoseconds*1e-9<next_sim: rclpy.spin_once(n,timeout_sec=.02)
            velocity()
            move('scenario_box',-5.,-5.)
        return 0
    except Exception as e: print(str(e),file=sys.stderr); return 1
    finally:
        for _ in range(3): velocity(); rclpy.spin_once(n,timeout_sec=.01)
        log.close(); n.destroy_node(); rclpy.try_shutdown()
if __name__=='__main__': sys.exit(main())
