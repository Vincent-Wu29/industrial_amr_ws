<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="industrial_amr">
  <xacro:arg name="controllers_file" default=""/>
  <material name="body_blue"><color rgba="0.12 0.32 0.44 1"/></material>
  <material name="tire"><color rgba="0.08 0.08 0.08 1"/></material>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.10"/></joint>
  <link name="base_link">
    <inertial><mass value="10"/><inertia ixx="0.06" ixy="0" ixz="0" iyy="0.145333" iyz="0" izz="0.181333"/></inertial>
    <visual><geometry><box size="0.40 0.24 0.12"/></geometry><material name="body_blue"/></visual>
    <collision><geometry><box size="0.40 0.24 0.12"/></geometry></collision>
  </link>
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <inertial><mass value="0.5"/><inertia ixx="0.000339" ixy="0" ixz="0" iyy="0.000625" iyz="0" izz="0.000339"/></inertial>
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.05" length="0.025"/></geometry><material name="tire"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.05" length="0.025"/></geometry></collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${side}_wheel_link"/><origin xyz="0 ${y} -0.05"/><axis xyz="0 1 0"/><dynamics damping="0.01" friction="0.0"/></joint>
    <gazebo reference="${side}_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1000000</kp><kd>10</kd></gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="0.13"/>
  <xacro:wheel side="right" y="-0.13"/>
  <xacro:macro name="caster" params="name x">
    <link name="${name}">
      <inertial><mass value="0.1"/><inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000025"/></inertial>
      <visual><geometry><sphere radius="0.025"/></geometry><material name="tire"/></visual>
      <collision><geometry><sphere radius="0.025"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="fixed"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} 0 -0.075"/></joint>
    <gazebo reference="${name}"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
  </xacro:macro>
  <xacro:caster name="front_caster" x="0.15"/><xacro:caster name="rear_caster" x="-0.15"/>
  <link name="laser_link"><inertial><mass value="0.1"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial><visual><geometry><cylinder radius="0.035" length="0.025"/></geometry><material name="tire"/></visual></link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="0 0 0.08"/></joint>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/></joint>
  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar"><topic>/scan</topic><gz_frame_id>laser_link</gz_frame_id><always_on>true</always_on><update_rate>10</update_rate>
      <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan><range><min>0.12</min><max>10.0</max><resolution>0.01</resolution></range></lidar>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link"><sensor name="imu" type="imu"><topic>/imu</topic><gz_frame_id>imu_link</gz_frame_id><always_on>true</always_on><update_rate>50</update_rate></sensor></gazebo>
  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="left_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="right_wheel_joint"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <ros><remapping>/diff_drive_controller/odom:=/odom</remapping></ros>
    </plugin>
  </gazebo>
</robot>
