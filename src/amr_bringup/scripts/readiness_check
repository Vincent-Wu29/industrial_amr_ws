#!/usr/bin/env python3
import argparse
import sys
import time
import rclpy
from rclpy.node import Node
from std_msgs.msg import Bool
from diagnostic_msgs.msg import DiagnosticArray

def main():
    p=argparse.ArgumentParser(); p.add_argument('--timeout',type=float,default=120); args=p.parse_args()
    rclpy.init(); n=Node('readiness_check'); ready=[False]; reasons=['no diagnostics']
    n.create_subscription(Bool,'/system/ready',lambda m:ready.__setitem__(0,m.data),10)
    def diagnostic(m):
        for s in m.status:
            if s.name=='system/readiness': reasons[0]=s.message
    n.create_subscription(DiagnosticArray,'/diagnostics',diagnostic,10)
    end=time.monotonic()+args.timeout
    while not ready[0] and time.monotonic()<end: rclpy.spin_once(n,timeout_sec=.2)
    print('READY' if ready[0] else reasons[0]); n.destroy_node(); rclpy.try_shutdown(); return 0 if ready[0] else 1
if __name__=='__main__': sys.exit(main())
